PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/leetlog
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
GROQ_API_KEY=your_groq_api_key_here
CLIENT_URL=http://localhost:5173

# Google Sheets (Service Account)
# 1. Go to Google Cloud Console → Create project → Enable Sheets API
# 2. Create a Service Account → Download JSON key
# 3. Share your Google Sheet with the service account email
# 4. Paste the values from the JSON key below
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Notion OAuth
# 1. Go to notion.so/my-integrations → Create integration → OAuth 2.0
# 2. Set redirect URI to: https://<your-backend-url>/api/v1/integrations/notion/callback
NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=your_notion_client_secret
NOTION_REDIRECT_URI=http://localhost:5000/api/v1/integrations/notion/callback
